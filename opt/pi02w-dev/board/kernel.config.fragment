# Dev-image kernel additions, merged on top of ../pi02w/board/kernel.config.
# The release image disables all of this; keep this file to the minimal delta
# needed for on-device development (networking, ssh, usb relay, hdmi console,
# keyboard/mouse, persistent ext4 data partition).
# NOTE: the release config sets CONFIG_MODULES=n, so everything here must be
# built-in (=y), never =m.

# Core networking
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y

# Onboard wifi (brcmfmac over SDIO; firmware from brcmfmac_sdio-firmware-rpi)
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y

# Wired networking via USB adapters (Zero 2 W has no ethernet jack; also
# covers the onboard USB ethernet of the Pi 3 family: smsc95xx / lan78xx)
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y

# USB relay: ethernet-over-USB gadget (dtoverlay=dwc2 + built-in g_ether).
# dwc2 must be dual-role so the same port still works as a host port for
# keyboards etc. when not tethered to a computer.
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y

# USB keyboard / mouse on the HDMI console
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# HDMI (matches the "#HDMI" breadcrumbs left in the release kernel.config).
# The framebuffer/console stack must be re-enabled HERE: the release config
# now disables FB/fbcon/DRM entirely (boot-speed: no display stack on the
# SPI-panel release image), so the dev HDMI console no longer inherits them
# from the base.
CONFIG_FB=y
CONFIG_FB_BCM2708=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y
CONFIG_DMA_BCM2708=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_AUXDISPLAY=y

# Persistent ext4 data partition (/dev/mmcblk0p2)
CONFIG_EXT4_FS=y

# Camera (libcamera/unicam). The release image uses the legacy GPU-firmware
# camera stack (start_x=1 + MMAL); libcamera instead needs the ARM-side drivers:
# unicam (CSI-2 receiver) + bcm2835-isp for the vc4 pipeline handler, the sensor
# drivers, and I2C to talk to the sensor (which sits behind the device tree
# i2c0mux pinctrl mux). Both sensors are built in so v1 (OV5647) and v2 (IMX219)
# modules work; the dtoverlay in boot_config.txt selects which one probes.
CONFIG_VIDEO_BCM2835_UNICAM=y
CONFIG_VIDEO_ISP_BCM2835=y
CONFIG_VIDEO_OV5647=y
CONFIG_VIDEO_IMX219=y
CONFIG_I2C_BCM2835=y
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PINCTRL=y

# The sensor's power rail (cam1_regulator, a "regulator-fixed" switched by GPIO 40)
# has to be enabled before it will answer on I2C. The legacy stack powered the
# sensor from the GPU firmware, so the ARM kernel never needed the regulator
# framework; without these the rail stays off and the sensor probe fails with
# -EREMOTEIO (-121).
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# unicam/ISP allocate frame buffers from CMA via dma-contig. CONFIG_CMA=y is already
# set in the base config, but without DMA_CMA nothing sets up a pool (CmaTotal: 0 kB)
# and capture cannot allocate buffers.
#
# Sizing is NOT controlled by CONFIG_CMA_SIZE_MBYTES here: the Pi device tree ships a
# "linux,cma" reserved-memory node asking for 64MB, and that node wins over the
# compiled-in default (a cma=<n>M kernel cmdline arg would in turn override the node).
# So the effective pool is 64MB and the value below is only a fallback if the DT node
# ever goes away.
#
# 64MB of CMA is what makes gpu_mem=32 in boot_config.txt load-bearing rather than a
# nicety. This image unpacks a ~230MB initramfs into RAM and holds a ~100MB compressed
# copy of it until init runs, so memory is tightest at boot: with the release image's
# gpu_mem=64 the ARM side gets 448MB, and reserving 64MB of that panics the kernel
# ("System is deadlocked on memory") before init. gpu_mem=32 lifts the ARM side to
# 480MB, which absorbs the reservation. Verified on hardware: 480MB - 64MB CMA boots
# and captures; 448MB - 64MB does not boot.
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=24
